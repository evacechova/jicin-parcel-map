{
    "name": "evacechova/jicin-parcel-map",
    "description": "Mapa parcel Jičín",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "scripts": {
        "dev": "@php -S 127.0.0.1:8000 -t public public/index.php",
        "db": "@php bin/database.php",
        "db:test": "@php bin/database.php --test",
        "verify:database": "@php tests/Integration/verify_database.php",
        "verify:importer": "@php tests/Importer/verify_parser_download.php",
        "verify:importer-db": "@php tests/Integration/verify_cadastral_import.php",
        "verify:importer-publication": "@php tests/Integration/verify_dataset_publication.php",
        "smoke:cuzk": "@php tests/Integration/smoke_cuzk_601101.php",
        "smoke:importer-db": "@php tests/Integration/smoke_cadastral_import_601101.php",
        "lint": [
            "@php -l app/bootstrap.php",
            "@php -l public/index.php",
            "@php -l app/Database/DatabaseConfig.php",
            "@php -l app/Database/ConnectionFactory.php",
            "@php -l app/Database/TestDatabaseGuard.php",
            "@php -l app/Database/MigrationRunner.php",
            "@php -l app/Import/ImportException.php",
            "@php -l app/Import/Scope/CadastralScope.php",
            "@php -l app/Import/Scope/DistrictBounds.php",
            "@php -l app/Import/Download/DownloadAttemptResult.php",
            "@php -l app/Import/Download/DownloadTransport.php",
            "@php -l app/Import/Download/CurlDownloadTransport.php",
            "@php -l app/Import/Download/DownloadedFile.php",
            "@php -l app/Import/Download/DownloadManager.php",
            "@php -l app/Import/Database/ImportTerritoryResult.php",
            "@php -l app/Import/Database/TerritoryImporter.php",
            "@php -l app/Import/Database/ImportRunRepository.php",
            "@php -l app/Import/Database/CadastralWriteRepository.php",
            "@php -l app/Import/Database/CadastralImportService.php",
            "@php -l app/Import/Database/DatasetValidationResult.php",
            "@php -l app/Import/Database/DatasetValidator.php",
            "@php -l app/Import/Database/ActivationResult.php",
            "@php -l app/Import/Database/DatasetPublicationService.php",
            "@php -l app/Import/Database/ImportPreflight.php",
            "@php -l app/Import/Database/FullImportResult.php",
            "@php -l app/Import/Database/FullImportRunner.php",
            "@php -l app/Import/Source/GmlZipArchive.php",
            "@php -l app/Import/Gml/GeometryValue.php",
