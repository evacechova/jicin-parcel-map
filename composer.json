            "@php -l app/Import/Gml/CadastralParcel.php",
            "@php -l app/Import/Gml/GmlStreamParser.php",
            "@php -l bin/database.php",
            "@php -l bin/import-cadastral.php",
            "@php -l tests/Integration/verify_database.php",
            "@php -l tests/Integration/verify_cadastral_import.php",
            "@php -l tests/Integration/smoke_cadastral_import_601101.php",
            "@php -l tests/Integration/verify_dataset_publication.php",
            "@php -l tests/Importer/verify_parser_download.php",
            "@php -l tests/Integration/smoke_cuzk_601101.php"
        ]
