{
    "name": "evacechova/jicin-parcel-map",
    "description": "Mapa parcel Jičín",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.5.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "scripts": {
        "dev": "@php -S 127.0.0.1:8000 -t public public/index.php",
        "db": "@php bin/database.php",
        "db:test": "@php bin/database.php --test",
        "lint": [
            "@php -l app/bootstrap.php",
            "@php -l public/index.php",
            "@php -l app/Database/DatabaseConfig.php",
            "@php -l app/Database/ConnectionFactory.php",
            "@php -l app/Database/TestDatabaseGuard.php",
            "@php -l app/Database/MigrationRunner.php",
            "@php -l bin/database.php"
        ]
    },
    "config": { "process-timeout": 0 }
}
